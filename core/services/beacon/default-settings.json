{
    "VERSION": 1,
    "default": {
      "domain_names": ["surfbee"],
      "advertise": ["_http"],
      "ip": "ips[0]"
    },
    "blacklist": ["lo", "docker"],
    "interfaces": [
      {
        "name": "eth0",
        "domain_names": ["surfbee", "surfbee-ethernet", "companion", "blueos"],
        "advertise": ["_mavlink", "_http"],
        "ip": "ips[*]"
      },
      {
        "name": "wlan0",
        "domain_names": ["surfbee-wifi"],
        "advertise": ["_http"],
        "ip": "ips[0]"
      },
      {
        "name": "uap0",
        "domain_names": ["surfbee-hotspot"],
        "advertise": ["_http"],
        "ip": "ips[0]"
      }
    ],
    "advertisement_types": [
      {
        "name": "_mavlink",
        "protocol": "_udp",
        "port": 14550,
        "properties": "{\"name\": \"ardusub\"}"
      },
      {
        "name": "_http",
        "protocol": "_tcp",
        "port": 80
      }
    ]
  }